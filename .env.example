# ===== Email settings for the contact form =====
# Your Gmail address (where messages arrive AND that sends the confirmation)
EMAIL_USER=rajsayantan12@gmail.com

# Gmail APP PASSWORD (NOT your normal password).
# Create one: Google Account → Security → 2-Step Verification (turn ON) →
# App passwords → generate → paste the 16-character code here (no spaces).
EMAIL_PASS=your_16_char_app_password_here

# The URL the "VISIT MY WEBSITE" button in the confirmation email points to
SITE_URL=https://your-site.vercel.app
